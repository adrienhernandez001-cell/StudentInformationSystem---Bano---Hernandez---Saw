@using StudentInformationSystem.Data

@{
    ViewData["Title"] = "Dashboard";

    var totalStudents = StudentRepository.Students.Count;
    var totalCourses = StudentRepository.Students
                        .Select(s => s.Course)
                        .Distinct()
                        .Count();
}

<h2 class="mb-4">Dashboard</h2>

<h4 class="mb-4 text-primary">
    Welcome Administrator
</h4>

<div class="row">

    <div class="col-md-3">
        <div class="card bg-primary text-white mb-3 shadow">
            <div class="card-body text-center">
                <h5>Total Students</h5>
                <h1>@totalStudents</h1>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-success text-white mb-3 shadow">
            <div class="card-body text-center">
                <h5>Total Courses</h5>
                <h1>@totalCourses</h1>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-warning text-dark mb-3 shadow">
            <div class="card-body text-center">
                <h5>Current Date</h5>
                <h6>@DateTime.Now.ToString("MMMM dd, yyyy")</h6>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-info text-white mb-3 shadow">
            <div class="card-body text-center">
                <h5>Status</h5>
                <h6>Administrator</h6>
            </div>
        </div>
    </div>

</div>

<div class="card shadow mt-4">

    <div class="card-header bg-dark text-white">
        Welcome
    </div>

    <div class="card-body">
        <h5>Student Information System</h5>

        <p>
            Welcome Administrator! You can manage students,
            search records, and monitor information using the
            navigation menu above.
        </p>
    </div>

</div>