@{
    ViewData["Title"] = "About";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h2>About Student Information System</h2>
        </div>

        <div class="card-body">

            <p>
                The Student Information System is a web application developed using
                ASP.NET Core MVC. It allows administrators to manage student
                information through a simple and user-friendly interface.
            </p>

            <h4>Features</h4>

            <ul>
                <li>Secure Login</li>
                <li>Dashboard</li>
                <li>Student List</li>
                <li>Add Student</li>
                <li>Search Student</li>
            </ul>

            <h4>Developers</h4>

            <table class="table table-bordered">
                <tr>
                    <th>Name</th>
