                </tr>

                <tr>
                    <td>Adrien Hernandez</td>
                    <td>Leader</td>
                </tr>

                <tr>
                    <td>Bano, Christine Jade</td>
                    <td>Student Management</td>
                </tr>

                <tr>
                    <td>Saw, Michael Jelbert</td>
                    <td>UI Design & Search Feature</td>
                </tr>

            </table>

            <p class="text-muted">
                Version 1.0
            </p>

        </div>

    </div>

